{
  "name": "@mojsica/react-mention-input",
  "version": "0.1.0",
  "description": "Contenteditable @mention input for React with chips and structured sections.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojsica/mention-input.git",
    "directory": "packages/react-mention-input"
  },
  "keywords": [
    "react",
    "mention",
    "contenteditable",
    "chips"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": ">=18 <21",
    "react-dom": ">=18 <21"
  },
  "dependencies": {
    "@mojsica/mention-core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.9.2",
    "vite": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
